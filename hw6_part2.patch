--- a/proc.c
+++ b/proc.c
@@ -73,7 +73,9 @@ found:
   memset(p->context, 0, sizeof *p->context);
   p->context->rip = (addr_t)forkret;
 
-  // TODO: initialize the mmap metadata for each new process
+  // Initialize the mmap metadata for each new process
+  p->mmaptop = (char*)MMAPBASE;
+  p->mmapcount = 0;
 
   return p;
 }
diff --git a/sysproc.c b/sysproc.c
index 9a9eb7a..c5c5a48 100644
--- a/sysproc.c
+++ b/sysproc.c
@@ -97,16 +97,86 @@ addr_t
 sys_mmap(void)
 {
   int fd, flags;
-  if(argint(0,&fd) < 0 || argint(1,&flags) < 0)
+  if(argint(0, &fd) < 0 || argint(1, &flags) < 0)
     return MMAP_FAILED;
 
-  // TODO: your implementation
-  return MMAP_FAILED;
+  // Validate the file descriptor
+  if(fd < 0 || fd >= NOFILE || proc->ofile[fd] == 0)
+    return MMAP_FAILED;
+
+  struct file *f = proc->ofile[fd];
+
+  // We only handle regular inode files
+  if(f->type != FD_INODE)
+    return MMAP_FAILED;
+
+  // Get the file size from the inode
+  ilock(f->ip);
+  uint filesize = f->ip->size;
+  iunlock(f->ip);
+
+  if(filesize == 0)
+    return MMAP_FAILED;
+
+  // Make sure we haven't exceeded the mmap slot limit
+  if(proc->mmapcount >= 10)
+    return MMAP_FAILED;
+
+  // The virtual address where this mapping starts
+  addr_t va = (addr_t)proc->mmaptop;
+
+  // How many bytes to reserve (rounded up to a page boundary)
+  addr_t rounded = PGROUNDUP(filesize);
+
+  // Allocate and map physical pages one at a time, reading file content as we go.
+  // We use the kernel virtual address (mem) returned by kalloc() directly,
+  // avoiding any need to call the static walkpgdir() from outside vm.c.
+  ilock(f->ip);
+  uint remaining = filesize;
+  uint off = 0;
+  addr_t a;
+  for(a = 0; a < rounded; a += PGSIZE) {
+    char *mem = kalloc();
+    if(mem == 0) {
+      iunlock(f->ip);
+      return MMAP_FAILED;
+    }
+    memset(mem, 0, PGSIZE);
+    if(mappages(proc->pgdir, (char*)(va + a), PGSIZE, V2P(mem), PTE_W | PTE_U) < 0) {
+      kfree(mem);
+      iunlock(f->ip);
+      return MMAP_FAILED;
+    }
+    // Read up to one page of file data into this physical page
+    if(remaining > 0) {
+      uint n = remaining < PGSIZE ? remaining : PGSIZE;
+      if(readi(f->ip, mem, off, n) != n) {
+        iunlock(f->ip);
+        return MMAP_FAILED;
+      }
+      off += n;
+      remaining -= n;
+    }
+  }
+  iunlock(f->ip);
+
+  // Record the mapping metadata
+  proc->mmaps[proc->mmapcount].fd = fd;
+  proc->mmaps[proc->mmapcount].start = va;
+  proc->mmapcount++;
+
+  // Advance mmaptop past the pages we just allocated
+  proc->mmaptop += rounded;
+
+  // Flush the TLB so the CPU uses the updated page table
+  switchuvm(proc);
+
+  return va;
 }
 
