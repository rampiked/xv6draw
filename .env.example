# Copy this file to .env and fill in the values you want to use locally.

# Preferred AI backend: gemini, openai, or auto.
AI_BACKEND=gemini

# Optional Gemini API key. If left empty, agent.py falls back to the next backend or canned responses.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional overrides for the local QEMU serial socket.
AIDRAW_HOST=127.0.0.1
AIDRAW_PORT=4444

# Optional Gemini model override.
GEMINI_MODEL=gemini-3-flash-preview

# Optional OpenAI API key. If left empty, agent.py uses canned responses.
OPENAI_API_KEY=

# Optional OpenAI model override.
OPENAI_MODEL=gpt-5.4
